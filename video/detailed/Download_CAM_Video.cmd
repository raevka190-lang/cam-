@echo off
setlocal
set "CAM_VIDEO_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $folder=$env:CAM_VIDEO_DIR; $target=Join-Path $folder 'CAM_NESTING_Detailed_Overview.mp4'; if(Test-Path -LiteralPath $target){throw 'The video already exists in this folder. Move the CMD to another folder to download again.'}; $temp=Join-Path $folder ('CAM_video_'+[Guid]::NewGuid().ToString('N')+'.partial'); $part=$temp+'.part'; try{ $stream=[IO.File]::Create($temp); try{ for($i=1;$i -le 14;$i++){ Write-Host ('Downloading '+$i+' / 14'); $url='https://raw.githubusercontent.com/raevka190-lang/cam-/main/video/detailed/parts/'+('overview.part{0:D2}' -f $i); Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $part; $bytes=[IO.File]::ReadAllBytes($part); $expected=if($i -lt 14){3000000}else{1587150}; if($bytes.Length -ne $expected){throw 'Incomplete download. Please run the CMD again.'}; $stream.Write($bytes,0,$bytes.Length); } }finally{$stream.Dispose()}; if((Get-FileHash -LiteralPath $temp -Algorithm SHA256).Hash -ne '9d162c40d138666c540efeaee798e1e3eadfd659b931f0a0819799b45399799f'){throw 'Video checksum mismatch. Please run the CMD again.'}; Move-Item -LiteralPath $temp -Destination $target; Write-Host ('Saved: '+$target); }finally{ Remove-Item -LiteralPath $part -Force -ErrorAction SilentlyContinue; Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue; }"
if errorlevel 1 echo Download failed. Please check the message above.
pause
